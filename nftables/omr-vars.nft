#
# Per-install values -- equivalent to shorewall4/params.net + params.vpn and
# shorewall6/params.net + params.vpn, merged into one file since a single
# `inet` table serves both address families (no more separate v4/v6 stacks).
#
# OMR_ADDR / OMR_ADDR6 / VPS_ADDR / VPS_IFACE are rewritten at runtime by
# omr-vps-admin's /vpnips endpoint whenever the router (re)announces its
# tunnel IPs.
#
define NET_IFACE = eth0
define VPS_IFACE  = tun0
define VPS_ADDR   = 10.255.252.1
define OMR_ADDR   = 10.255.252.2
define OMR_ADDR6  = fd00::a00:2

# Interface-group definitions -- equivalent to shorewall4/6 zones + interfaces
# (the vpn/vpncl zone assignments there, e.g. `vpn tun+ nosmurfs,tcpflags`).
# nft's iifname/oifname support a trailing "*" wildcard natively, so each
# Shorewall `+`-suffixed interface name maps 1:1 to a `*`-suffixed one here.
define VPN_IFACES = { "gt-tun*", "gt-udp-tun*", "mlvpn*", "tun*", "wg*", "dsvpn*", "mqvpn*", "gre-user*", "vx-user*", "omr-bonding", "tap_softether" }
define VPNCL_IFACES = { "client-wg*" }
