[Unit]
Description=OMR VXLAN on %I
After=network.target network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/omr-vxlan-run start /etc/openmptcprouter-vps-admin/omr-vxlan/%i
RemainAfterExit=true
ExecStop=/usr/local/bin/omr-vxlan-run stop /etc/openmptcprouter-vps-admin/omr-vxlan/%i

[Install]
WantedBy=multi-user.target
