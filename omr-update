#!/bin/sh
# Triggered by omr-vps-admin dropping a marker file: /update for a full
# reinstall from the web, /update-bin for the binaries update the omr-server
# package asks for from its postinst.
# The channel is the one of the installed installer: a VPS on server-test
# stays on server-test instead of being moved to the stable release by the
# full reinstall. "server" (stable) when it can't be read.
INSTALLED_INSTALLER=/usr/share/omr-server/debian9-x86_64.sh
VPSPATH="$(sed -n 's/^VPSPATH="\([A-Za-z0-9_-]*\)"$/\1/p' "$INSTALLED_INSTALLER" 2>/dev/null | head -n 1)"
[ -n "$VPSPATH" ] || VPSPATH="server"
if [ -f /etc/openmptcprouter-vps-admin/update ]; then
	installer="$(mktemp /tmp/omr-update.XXXXXX)" || exit 1
	# Do not pipe the network response into a root shell: POSIX pipelines report
	# only the last command's status, so an empty response from a failed wget can
	# look like a successful install.  Download over TLS, then execute only when
	# the download completed successfully.
	#
	# Run it with sh, not bash: the installer is #!/bin/sh and carries no
	# bashisms, and naming the interpreter here overrides its shebang.  Under
	# bash the six `echo "\033[1m...\033[0m"` lines print their escapes
	# literally instead of rendering, which includes the line that shows the
	# generated omr-admin password.
	if wget -O "$installer" "https://www.openmptcprouter.com/${VPSPATH}/debian.sh" \
		&& sh "$installer"; then
		rm -f "$installer" /etc/openmptcprouter-vps-admin/update
		reboot
	else
		rc=$?
		rm -f "$installer"
		echo "omr-update: the full installer failed, keeping /etc/openmptcprouter-vps-admin/update so the next run retries" >&2
		exit "$rc"
	fi
fi
if [ -f /etc/openmptcprouter-vps-admin/update-bin ]; then
        # Wait for the package manager first. This unit is started by the
        # omr-server postinst, i.e. from inside an apt or dpkg run that still
        # holds /var/lib/dpkg/lock-frontend, and the installer's own
        # "apt-get check" a few lines into the run ends the whole thing there:
        #   E: Unable to acquire the dpkg frontend lock ... process N (apt-get)
        #   E: `apt-get check` failed, you may have broken packages. Aborting...
        # which took one second and left nothing behind but the removed flag.
        i=0
        # A process name is cut to 15 characters: unattended-upgrade runs as
        # "unattended-upgr", which "unattended-upgrade" never matched
        while [ $i -lt 600 ] && pgrep -x "apt|apt-get|dpkg|unattended-upgr" >/dev/null 2>&1; do
                sleep 1
                i=$((i + 1))
        done
        # No LOCALFILES=/SOURCES= here on purpose: debian/postinst rewrites
        # this copy's own "LOCALFILES=${LOCALFILES:-no}" and
        # "SOURCES=${SOURCES:-no}" into plain "no", and a bare assignment beats
        # the environment -- so passing them in only looked like it selected
        # the local-files and build-from-sources paths. The run takes the
        # download branch, which is what it has always done.
        if REINSTALL=no /usr/share/omr-server/debian9-x86_64.sh; then
                rm -f /etc/openmptcprouter-vps-admin/update-bin
        else
                echo "omr-update: the installer failed, keeping /etc/openmptcprouter-vps-admin/update-bin so the next run retries" >&2
        fi
        #reboot
fi
