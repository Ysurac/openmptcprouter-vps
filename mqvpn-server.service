[Unit]
Description=mqvpn VPN Server
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/mp0rta/mqvpn
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/mqvpn --config /etc/mqvpn/server.json
Restart=on-failure
RestartSec=5

# Security hardening
# mqvpn runs as root. The server needs CAP_NET_ADMIN for its tun device (mqvpn0)
# and to raise its UDP socket buffers (SO_SNDBUFFORCE/SO_RCVBUFFORCE), and
# CAP_NET_BIND_SERVICE because omr-admin's /mqvpn API can move its UDP port
# below 1024 (443 when the request omits the port).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadOnlyPaths=/etc/mqvpn
ReadWritePaths=/dev/net/tun
RuntimeDirectory=mqvpn

[Install]
WantedBy=multi-user.target
